# Jira Configuration
JIRA_HOST=yourorg.atlassian.net
JIRA_EMAIL=service-account@yourorg.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_SECOPS_PROJECT_KEY=SECOPS
# Optional full JQL override. The default finds open issues whose summary contains "User-reported phishing".
# JIRA_PHISHING_JQL=project = "SECOPS" AND labels = phishing-intake AND statusCategory != Done ORDER BY created DESC

# Google Workspace Configuration
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SUBJECT_EMAIL=admin@yourorg.com
GOOGLE_ADMIN_EMAIL=admin@yourorg.com

# VirusTotal Configuration
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# SecureCatch access control
# Generate the password hash with: printf '%s' 'a-long-password' | npm run auth:hash-password
SECURECATCH_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-with-salt$replace-with-hash
# Generate a random secret with: openssl rand -base64 48
SECURECATCH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Safety gate. Keep false until authentication is configured and a dry run has been reviewed.
SECURECATCH_ENABLE_DESTRUCTIVE_ACTIONS=false

# Database
DATABASE_URL=file:./dev.db
